APP_NAME=Pitchbar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Application release shown in the admin (changelog, about). Ships with the
# release; leave as-is unless you maintain your own fork.
VERSION=2.1.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Master switch for the multilingual layer (language picker, runtime locale
# switching, geo-suggestion banner, and the admin Translation Manager).
# Default false = English-only. Set true to enable languages.
MULTILINGUAL_ENABLED=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- Database (Postgres via docker-compose) ----------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pitchbar
DB_USERNAME=pitchbar
DB_PASSWORD=pitchbar

# ---------- Sessions / Cache / Queue ----------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcast driver for live admin updates (Inbox claims, lead alerts,
# typing indicators). "log" is a safe default for installs without a
# running Reverb server — the admin UI falls back to polling, so
# functionality is unchanged, just slightly less snappy. Switch to
# "reverb" and start `php artisan reverb:start` when you want real-time
# updates pushed to the browser instead.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# Must exceed the slowest job timeout (conversation export is 600s).
REDIS_QUEUE_RETRY_AFTER=660

# ---------- Redis ----------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------- Octane ----------
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
OCTANE_MAX_EXECUTION_TIME=0

# Inertia SSR. Docker production points this at the `ssr` service.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# ---------- Reverb (WebSockets) ----------
REVERB_APP_ID=pitchbar-local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ---------- Horizon ----------
HORIZON_PREFIX=pitchbar:horizon:

# ---------- Widget JWT ----------
WIDGET_JWT_SECRET=change-me-in-production

# ---------- Provider routing ----------
# LLM_PROVIDER=cloudflare|openai|openrouter (auto-picked from keys below if blank;
#   openrouter must be set explicitly — we don't auto-bind on a stale OPENROUTER_API_KEY).
# VECTOR_PROVIDER=cloudflare|qdrant (auto-picked from keys below if blank)
LLM_PROVIDER=
VECTOR_PROVIDER=

# ---------- RAG tuning ----------
# Default similarity threshold for new agents. Cloudflare bge-base scores
# typically peak around 0.55–0.65 for in-domain matches; OpenAI peaks higher.
# Leave blank to auto-pick (0.5 for Cloudflare, 0.78 for OpenAI).
RAG_CONFIDENCE_THRESHOLD=
# Set to false to bypass the bge-reranker-base second-stage rerank.
RAG_RERANK_ENABLED=true
# Reranker HTTP timeout in seconds. Deliberately short: a slow reranker
# should fail fast to the ANN ordering rather than stall the whole turn
# past the widget's own connection timeout.
RAG_RERANK_TIMEOUT_SECONDS=3

# ---------- Crawler tuning ----------
CRAWL_MAX_PAGES_PER_SOURCE=25
CRAWL_PAGE_DISPATCH_DELAY=2

# ---------- Cloudflare (one bill: chat, embeddings, vector DB, browser, R2) ----------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-base-en-v1.5
CLOUDFLARE_AI_GATEWAY_URL=
CLOUDFLARE_VECTORIZE_INDEX=pitchbar-chunks
CLOUDFLARE_BROWSER_RENDERING=true
# Daily caps. 0 = unlimited. Browser Rendering counts /content +
# /markdown + /screenshot invocations against one bucket; vision OCR
# (Workers AI Neurons) has its own.
CLOUDFLARE_BROWSER_DAILY_LIMIT=0
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
CLOUDFLARE_VISION_DAILY_LIMIT=0

# ---------- OpenAI (optional fallback) ----------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_ORGANIZATION=

# ---------- OpenRouter (optional, free models available — set LLM_PROVIDER=openrouter to use) ----------
# OpenRouter exposes an OpenAI-compatible API; we reuse OpenAiHttpClient
# with their base URL. Free chat models include
# meta-llama/llama-3.3-70b-instruct:free and mistralai/mistral-7b-instruct:free.
# Embeddings aren't on the free tier — IndexDocumentJob falls back to
# OPENAI_API_KEY when set.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_EMBED_MODEL=text-embedding-3-small

# ---------- Qdrant (optional fallback to Cloudflare Vectorize) ----------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=pitchbar_chunks

# ---------- Browserless (optional, only if CF Browser Rendering not used) ----------
BROWSERLESS_URL=https://chrome.browserless.io
BROWSERLESS_TOKEN=

# ---------- Notion OAuth (knowledge-base ingestion) ----------
# Create a public integration at https://www.notion.so/my-integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=${APP_URL}/app/oauth/notion/callback

# ---------- Google OAuth (Drive + Docs + Sheets ingestion) ----------
# Register OAuth client in GCP console with scopes:
#   https://www.googleapis.com/auth/drive.readonly
#   https://www.googleapis.com/auth/documents.readonly
#   https://www.googleapis.com/auth/spreadsheets.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/app/oauth/google/callback

# ---------- Marketing demo widget ----------
# Run `php artisan pitchbar:seed-demo-agent` and copy the printed UUID here
# to enable the live demo widget on the marketing pages.
MARKETING_DEMO_AGENT_ID=

# Set DEMO=YES on staging / CodeCanyon preview deployments to surface a
# click-to-fill credentials block on the login page. Leave empty / NO in
# production — the seeded passwords are publicly known.
DEMO=NO

# ---------- Payment gateways ----------
# Stripe / Cashier
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd

# PayPal (REST API credentials, sandbox by default)
PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Razorpay (UPI, cards, netbanking)
RAZORPAY_ENABLED=false
RAZORPAY_API_KEY=
RAZORPAY_SECRET_KEY=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Mail (Mailpit locally) ----------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@pitchbar.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Object storage (R2 / S3) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=

# ---------- Sentry ----------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ---------- OpenTelemetry ----------
OTEL_SERVICE_NAME=pitchbar
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_PHP_AUTOLOAD_ENABLED=false

# ---------- Vite ----------
VITE_APP_NAME="${APP_NAME}"
VITE_WIDGET_CDN_URL=http://localhost:5173
