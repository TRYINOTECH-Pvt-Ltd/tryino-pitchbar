# Production env for Hostinger Docker Manager / Portainer / compose.
#   cp .env.production.example .env
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"   # APP_KEY
#   openssl rand -hex 32                                              # WIDGET_JWT_SECRET
#
# DB_HOST / REDIS_HOST / INERTIA_SSR_URL are overridden by docker-compose.yml
# to the internal service names. Keep APP_URL as the public HTTPS origin.
# Do not run migrate/seed on the VPS — register at /register, then
# Settings → System (the in-app installer).

APP_NAME=Pitchbar
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pitch.tryinotech.com
APP_DOMAIN=pitch.tryinotech.com
APP_PORT=8000
PITCHBAR_SELF_HOST=true

VERSION=2.1.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
MULTILINGUAL_ENABLED=false

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Compose overrides host to `postgres`. Password is required (stack will not start without it).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pitchbar
DB_USERNAME=pitchbar
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# `log` = inbox polls (no extra process). `reverb` requires:
#   docker compose --profile realtime up -d
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# IndexDocumentJob timeout is 180s; conversation export is 600s.
REDIS_QUEUE_RETRY_AFTER=660

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=500
OCTANE_MAX_EXECUTION_TIME=0

INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://ssr:13714

REVERB_APP_ID=pitchbar
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public hostname browsers connect to (your domain, behind TLS).
REVERB_HOST=pitch.tryinotech.com
REVERB_PORT=443
REVERB_SCHEME=https
# Bind address inside the container (do not change).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

HORIZON_PREFIX=pitchbar:horizon:

WIDGET_JWT_SECRET=

LLM_PROVIDER=
VECTOR_PROVIDER=

RAG_CONFIDENCE_THRESHOLD=
RAG_RERANK_ENABLED=true
RAG_RERANK_TIMEOUT_SECONDS=3

CRAWL_MAX_PAGES_PER_SOURCE=25
CRAWL_PAGE_DISPATCH_DELAY=2

# AI / mail / Stripe — leave blank and paste them in Settings → System
# after you promote the first user. The UI encrypts them into app_settings.
# Filling these here is optional (also works); the in-app installer is the
# supported first-run path.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-base-en-v1.5
CLOUDFLARE_AI_GATEWAY_URL=
CLOUDFLARE_VECTORIZE_INDEX=pitchbar-chunks
CLOUDFLARE_BROWSER_RENDERING=true
CLOUDFLARE_BROWSER_DAILY_LIMIT=0
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
CLOUDFLARE_VISION_DAILY_LIMIT=0

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_ORGANIZATION=

OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_EMBED_MODEL=text-embedding-3-small

# Only if you start the stack with --profile qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pitchbar_chunks

BROWSERLESS_URL=
BROWSERLESS_TOKEN=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=${APP_URL}/app/oauth/notion/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/app/oauth/google/callback

MARKETING_DEMO_AGENT_ID=
DEMO=NO

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd

PAYPAL_ENABLED=false
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

RAZORPAY_ENABLED=false
RAZORPAY_API_KEY=
RAZORPAY_SECRET_KEY=
RAZORPAY_WEBHOOK_SECRET=

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.0

OTEL_SERVICE_NAME=pitchbar
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_PHP_AUTOLOAD_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
VITE_WIDGET_CDN_URL=
